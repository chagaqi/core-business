# Tideover environment knobs. The public demo needs NONE of these set —
# every variable here gates optional production behavior.

# ── Operator auth (ADR-0004) ─────────────────────────────────────────────
# DEMO_MODE: unset or anything but "false" = demo (all surfaces open, seeded
# data). Set to "false" to require login for /app/* and the operator APIs.
# DEMO_MODE=false

# APP_PASSWORD: the single shared operator password checked by /login.
# Required when DEMO_MODE=false. Rotate it to revoke access.
# APP_PASSWORD=

# AUTH_SECRET: HMAC-SHA256 key for the signed session cookie. Required when
# DEMO_MODE=false. Use a long random string; rotating it logs everyone out.
# AUTH_SECRET=

# ── Resend inbound email ingest (ADR-0008) ───────────────────────────────
# The "integration = one forwarding rule" wedge: a merchant forwards their
# support alias to <inboxToken>@in.tideover.app and Tideover ingests it.
#
# Live activation is a Resend-dashboard + DNS step (not code):
#   1. Add the MX record Resend gives you to the `in.tideover.app` subdomain
#      (a dedicated host, separate from the `mail.tideover.app` sending domain).
#   2. Configure the Resend inbound webhook to POST /api/inbound/resend and copy
#      its signing secret into RESEND_WEBHOOK_SECRET below.
# Until RESEND_WEBHOOK_SECRET is set, the route accepts unsigned payloads ONLY in
# demo mode (DEMO_MODE != false) so the seeded/test path works; with the secret
# set it requires a valid Svix signature.

# RESEND_WEBHOOK_SECRET: Svix signing secret for the inbound webhook, shaped
# `whsec_<base64>`. Required to accept live inbound outside demo mode.
# RESEND_WEBHOOK_SECRET=

# RESEND_API_KEY: reused from outbound sending — the inbound route calls
# GET https://api.resend.com/emails/receiving/{id} with it to fetch the body
# (the webhook itself carries metadata only).
# RESEND_API_KEY=

# ── Per-merchant helpdesk webhook ingest (ADR-0011) ──────────────────────
# The clean API integration path: a merchant's helpdesk (Gorgias/Zendesk) POSTs
# a canonical, tag-filtered ticket to POST /api/ingest/[channel]/[token], where
# [token] is the merchant's inboxToken. Merchant identity rides on the URL token
# (no forgeable ?merchant= param), and each merchant's signing secret is DERIVED:
#   webhookSecret = HMAC_SHA256(WEBHOOK_ROOT_SECRET, inboxToken)  (hex)
# so no new per-merchant field is stored and rotating the token rotates the
# secret. The onboarding "Connect your helpdesk" panel shows the merchant this
# value to paste into their webhook tool. Merchants send it back as
#   X-Tideover-Signature: sha256=<hmac of the raw body>
# Until WEBHOOK_ROOT_SECRET is set, the route accepts unsigned payloads ONLY in
# demo mode (DEMO_MODE != false, NODE_ENV != production) so the seeded/test path
# works; with the root set it requires a valid signature and fails closed in prod.

# WEBHOOK_ROOT_SECRET: root key the per-merchant webhook secrets are derived
# from. Set a long random string in production; rotating it rotates every
# merchant's webhook secret. Leave unset in demo.
# WEBHOOK_ROOT_SECRET=
