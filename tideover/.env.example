# Tideover environment knobs. The public demo needs NONE of these set —
# every variable here gates optional production behavior.

# ── Operator auth + mode (ADR-0004, ADR-0017) ────────────────────────────
# Mode is derived from the request HOST: the real app host (REAL_APP_HOST below)
# runs "real" — /app/* and the operator APIs require login; every other host,
# including the public demo, runs "demo" — all surfaces open on seeded data.
# DEMO_MODE overrides that per env for backcompat.
#
# DEMO_MODE: leave unset for host-derived mode. "false" forces real (gate ON) on
# EVERY host; "true" forces demo (gate OFF) on every host. Missing = host-derived.
# DEMO_MODE=false
#
# NEXT_PUBLIC_DEMO_MODE: the CLIENT-side twin of DEMO_MODE (build-time inlined —
# the marketing mega-menu uses it to decide whether its Features items deep-link
# into the /app sample cockpit or fall back to marketing anchors). SET IT TO THE
# SAME VALUE AS DEMO_MODE on every deploy; unset = demo links (correct for the
# public marketing/demo deploy). A deploy with DEMO_MODE=false but this unset
# leaves the mega-menu pointing at /app/* which dead-ends at /login.
# NEXT_PUBLIC_DEMO_MODE=true

# REAL_APP_HOST: the host that runs in real mode (login-gated, live datastore).
# Defaults to "app.tideover.app". Missing = the default; set it if the real app
# is served from a different host, or the gate/datastore key off the wrong one.
# REAL_APP_HOST=app.tideover.app

# APP_PASSWORD: the single shared operator password checked by /login.
# Required in real mode. Missing = no one can log into the real app. Rotate to revoke.
# APP_PASSWORD=

# AUTH_SECRET: HMAC-SHA256 key for the signed session cookie. Required in real
# mode. Missing = /login can't mint a session (no one gets in). Use a long random
# string; rotating it logs everyone out.
# AUTH_SECRET=

# STATUS_TOKEN_SECRET: HMAC-SHA256 key signing customer /status/[token] URLs.
# Missing = tokens are signed with a public "dev-only" default, so status URLs
# become guessable/forgeable in production. Set a long random string live.
# STATUS_TOKEN_SECRET=

# ── Auth0 user accounts + per-merchant tenancy (ADR-0020) ────────────────
# Real-mode auth mechanism is env-selected. ALL FIVE vars unset = the legacy
# shared-password mode above (APP_PASSWORD/AUTH_SECRET), unchanged. All five
# set = Auth0 per-user accounts: /auth/login|logout|callback are served by
# @auth0/nextjs-auth0 v4, each user owns at most one merchant (ownerSub), and
# operator surfaces only ever see the signed-in user's own merchant.
# FAIL-CLOSED RULE: setting ANY of the five flips the deployment to auth0
# mode; a partial set makes the operator surfaces return an explicit 500 —
# never a silent fall-back to the shared password, never an open gate. Fix
# the missing vars to recover. Demo hosts ignore all of this.
# Names are the SDK v4 contract (v3's AUTH0_BASE_URL / AUTH0_ISSUER_BASE_URL
# are NOT read).

# AUTH0_DOMAIN: the Auth0 tenant domain, e.g. tideover.us.auth0.com.
# AUTH0_DOMAIN=

# AUTH0_CLIENT_ID / AUTH0_CLIENT_SECRET: the Auth0 application ("Regular Web
# Application") credentials. Callback URL in Auth0 must be
# https://<REAL_APP_HOST>/auth/callback; logout URL https://<REAL_APP_HOST>.
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=

# AUTH0_SECRET: 32+ byte random string encrypting the session cookie
# (generate: openssl rand -hex 32). Rotating it logs every user out.
# AUTH0_SECRET=

# APP_BASE_URL: this app's own origin, e.g. https://app.tideover.app. Required
# explicitly — the SDK's Host-header inference is disabled by the fail-closed
# completeness check.
# APP_BASE_URL=

# NEXT_PUBLIC_REAL_APP_HOST: build-time twin of REAL_APP_HOST for the
# marketing bundle (inlined like NEXT_PUBLIC_DEMO_MODE). Set on the PUBLIC
# MARKETING deploy so the "Get started" nav CTA points at
# https://<this value>/onboarding (the real, login-gated wizard). Unset =
# relative /onboarding (correct for the demo sandbox deploy).
# NEXT_PUBLIC_REAL_APP_HOST=app.tideover.app

# ── Datastore (ADR-0003, ADR-0017) ───────────────────────────────────────
# Real mode always uses MongoDB (the live pilot store) and REFUSES to start
# without MONGODB_URI — it never falls back to the in-memory JSON store, because
# that would be silent pilot data loss. Demo mode uses DATA_DRIVER (JSON default).
#
# DATA_DRIVER: demo-mode backend. unset | json | mock → in-memory JSON store
# (default; resets each deploy). "mongo" → MongoDB against MONGODB_DB. Ignored in
# real mode (always MongoDB). Missing = json.
# DATA_DRIVER=json

# MONGODB_URI: MongoDB connection string. Required in real mode (and in demo when
# DATA_DRIVER=mongo). Missing in real mode = the app throws rather than serve the
# demo store; missing in demo/json = fine, never read.
# MONGODB_URI=

# MONGODB_DB: database name for DEMO mongo (DATA_DRIVER=mongo). Missing = "tideover".
# MONGODB_DB=tideover

# MONGODB_DB_LIVE: database name for REAL mode — the live pilot store, kept
# strictly separate from the demo db so pilot data never mixes with seeded
# sample data. Missing = "tideover_live".
# MONGODB_DB_LIVE=tideover_live

# ── Resend inbound email ingest (ADR-0008) ───────────────────────────────
# The "integration = one forwarding rule" wedge: a merchant forwards their
# support alias to <inboxToken>@in.tideover.app and Tideover ingests it.
#
# Live activation is a Resend-dashboard + DNS step (not code):
#   1. Add the MX record Resend gives you to the `in.tideover.app` subdomain
#      (a dedicated host, separate from the `mail.tideover.app` sending domain).
#   2. Configure the Resend inbound webhook to POST /api/inbound/resend and copy
#      its signing secret into RESEND_WEBHOOK_SECRET below.
# Until RESEND_WEBHOOK_SECRET is set, the route accepts unsigned payloads ONLY in
# demo mode (DEMO_MODE != false, NODE_ENV != production) so the seeded/test path
# works; with the secret set it requires a valid Svix signature.

# RESEND_WEBHOOK_SECRET: Svix signing secret for the inbound webhook, shaped
# `whsec_<base64>`. Required to accept live inbound outside demo mode.
# RESEND_WEBHOOK_SECRET=

# RESEND_API_KEY: reused from outbound sending — the inbound route calls
# GET https://api.resend.com/emails/receiving/{id} with it to fetch the body
# (the webhook itself carries metadata only).
# RESEND_API_KEY=

# ── Per-merchant helpdesk webhook ingest (ADR-0011, ADR-0021) ────────────
# The clean API integration path: a merchant's helpdesk POSTs a canonical,
# tag-filtered ticket to POST /api/ingest/[channel]/[token], where [token] is the
# merchant's inboxToken. Merchant identity rides on the URL token (no forgeable
# ?merchant= param).
#
# AUTH IS PER VENDOR (ADR-0021), because most helpdesks CANNOT compute a body
# HMAC — Gorgias sends only static headers, Help Scout signs with its own
# HMAC-SHA1 scheme, Zendesk sends a bearer. Every credential is still DERIVED
# from the root + the merchant's inboxToken, so NO new per-merchant field is
# stored and rotating the token rotates all of them:
#
#   credential(purpose) = HMAC_SHA256(WEBHOOK_ROOT_SECRET, "<purpose>:<inboxToken>")
#
#   generic  /webhook    X-Tideover-Signature: sha256=<hex HMAC-SHA256(raw body)>
#   gorgias  /gorgias    Authorization: Bearer tdo_<hex>      (static header)
#   zendesk  /zendesk    Authorization: Bearer tdo_<hex>      (static header)
#   helpscout /helpscout X-HelpScout-Signature: base64(HMAC-SHA1(raw body))
#                        — verified with a 32-char key the merchant pastes into
#                          Help Scout's own "Secret Key" field.
#
# The "Connect your helpdesk" panel shows each merchant the exact value to paste,
# and its "Send a test event" button proves the wiring through the real gate.
#
# POSTURE (unchanged, fails CLOSED): unauthenticated payloads are accepted ONLY
# in demo (DEMO_MODE != false AND NODE_ENV != production AND no root secret set).
# NODE_ENV=production is NEVER the demo branch, even with DEMO_MODE unset. And a
# MISSING WEBHOOK_ROOT_SECRET outside demo is itself a rejection: an empty root
# makes every derived credential computable from the PUBLIC url token, so
# accepting would mean accepting a forgeable secret.

# WEBHOOK_ROOT_SECRET: root key every per-merchant ingest credential is derived
# from. Set a long random string in production; rotating it rotates every
# merchant's credentials (they must re-paste). Leave unset in demo.
# WEBHOOK_ROOT_SECRET=

# INGEST_IP_ALLOWLIST (optional, OFF by default): comma-separated exact IPs and/or
# IPv4 CIDRs that ingest will accept, e.g. "52.10.0.0/16,203.0.113.7". Defense in
# depth for the bearer schemes, which are replayable shared secrets rather than
# body signatures. LEAVE IT UNSET UNLESS YOU KNOW YOUR VENDOR'S EGRESS RANGES —
# a wrong range silently refuses every ticket, which is the exact failure mode
# ADR-0021 exists to eliminate. (It will at least be LOUD: /app/setup shows the
# refusals and the reason.)
# INGEST_IP_ALLOWLIST=

# ── Scheduled jobs / Vercel Cron (ADR-0013) ──────────────────────────────
# The daily sweep GET /api/cron/sweep-outcomes emits `resolved_quiet` outcome
# events (a send with no reply/reopen for 7 days = the wait settled). Vercel Cron
# is configured in vercel.json (08:00 UTC) and, when CRON_SECRET is set in project
# env, attaches `Authorization: Bearer <CRON_SECRET>` to the request automatically.
# The route FAILS CLOSED in production: with NODE_ENV=production it 401s if
# CRON_SECRET is unset OR the bearer header doesn't match — it never runs
# unauthenticated in prod (mirrors the ingest posture). In demo/dev it runs
# unauthenticated so the sweep is testable against the seed.

# CRON_SECRET: shared secret Vercel Cron sends as a bearer token. Required in
# production to authorize the sweep; leave unset in demo. Use a long random string.
# CRON_SECRET=

# ── LLM drafting (ADR-0018) ──────────────────────────────────────────────
# Optional AI reply drafting. ALL THREE unset = deterministic-only drafting
# (the shipped demo posture; nothing leaves the app). When set, LlmDrafter
# drafts each matched ticket with the merchant's tenant profile in the system
# prompt, then enforces the floor: provider error, 8s timeout, empty output,
# or an ADR-0014 QA-gate failure (hard delivery date) all fall back to the
# deterministic draft. Every draft — LLM or not — still requires human approval.
#
# LLM_PROVIDER: which adapter to call. "deepseek" is wired (Dylan, 2026-07-09);
# any other value falls back to deterministic drafting with a logged warning,
# so a typo can never break drafting. Missing = deterministic-only.
# LLM_PROVIDER=deepseek

# LLM_API_KEY: the provider API key. Missing (even with LLM_PROVIDER set) =
# deterministic-only. Lives only here / in Vercel env, never in the repo.
# LLM_API_KEY=

# LLM_MODEL: model id passed to the provider. Missing = "deepseek-chat".
# LLM_MODEL=deepseek-chat
