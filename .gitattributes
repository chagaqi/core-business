# Normalize line endings to LF in the repo and on checkout everywhere (OS7).
# Prevents CRLF drift when the repo is edited across Windows + macOS — a Mac
# editor writing LF against CRLF-in-repo files would otherwise show spurious
# diffs, and CRLF creeping into the seed JSON would break byte-identical
# seed-check. core.autocrlf is not relied on; these attributes are authoritative.
* text=auto eol=lf

# Build- and seed-critical text types, pinned explicitly (belt-and-suspenders).
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.csv   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.env.example text eol=lf

# Binary — git must never touch line endings on these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
